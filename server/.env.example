# ─────────────────────────────────────────────────────────
# Server environment configuration
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env to version control.
# ─────────────────────────────────────────────────────────

# MongoDB connection string from MongoDB Atlas
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/faculty_feedback
MONGODB_URI=

# Port the Express server will listen on
PORT=5000

# JWT secret key — use a long, random string
JWT_SECRET=

# Node environment (development | production)
NODE_ENV=development

# Initial admin account (used only by the seed script — see server/scripts/seedAdmin.js)
ADMIN_EMAIL=
ADMIN_PASSWORD=
